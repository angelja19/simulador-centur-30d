{
  "name": "simulador-centur-30d",
  "version": "1.0.0",
  "description": "Simulador educativo del torno CNC ROMI Centur 30D con control Mach 9 (no es software de ROMI)",
  "author": "angelja19",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron": "electron .",
    "dist:win": "vite build --mode electron && electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "io.github.angelja19.centur30d",
    "productName": "Simulador Centur 30D",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icons/icon.ico",
      "artifactName": "Simulador-Centur-30D-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Simulador Centur 30D"
    }
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/saira-condensed": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "jspdf": "^4.2.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
